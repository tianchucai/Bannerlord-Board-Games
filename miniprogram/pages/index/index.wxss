.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #2b2b2b;
}

/* 标题栏 */
.header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.title {
  font-size: 40rpx;
  color: #eee;
}

.header-btns {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  gap: 16rpx;
}

.rules-btn {
  font-size: 26rpx;
  color: #f0c060;
  border: 1rpx solid #f0c060;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
}

.status {
  height: 48rpx;
  line-height: 48rpx;
  margin: 8rpx 0 16rpx;
}

.status-text {
  color: #ccc;
  font-size: 28rpx;
}

.thinking {
  color: #f0c060;
  font-size: 28rpx;
}

.board {
  position: relative;
  display: grid;
  grid-template-columns: repeat(9, 72rpx);
  grid-template-rows: repeat(9, 72rpx);
  gap: 4rpx;
  padding: 12rpx;
  background: #d9b382;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.cell {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: #c79a66;
  border-radius: 6rpx;
}

.cell-throne {
  background: #8a5a2b;
}

.cell-stronghold {
  background: #b98950;
}

.piece {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  transition: transform 0.15s ease;
}

.piece-attacker {
  background: #222;
  box-shadow: inset 0 -4rpx 6rpx rgba(0, 0, 0, 0.6), 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.piece-defender {
  background: #f5f5f5;
  box-shadow: inset 0 -4rpx 6rpx rgba(0, 0, 0, 0.2), 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

.piece-king {
  background: #f0c060;
  box-shadow: inset 0 -4rpx 6rpx rgba(0, 0, 0, 0.3), 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.piece-selected {
  transform: translate(-50%, -50%) scale(1.15);
}

/* 底部操作区 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.mode-toggle {
  display: flex;
  background: #3a3a3a;
  border-radius: 28rpx;
  padding: 6rpx;
}

.mode-option {
  font-size: 26rpx;
  color: #999;
  padding: 12rpx 40rpx;
  border-radius: 24rpx;
}

.mode-active {
  background: #f0c060;
  color: #2b2b2b;
}

.restart-btn {
  font-size: 28rpx;
  color: #ccc;
  border: 1rpx solid #666;
  border-radius: 28rpx;
  padding: 14rpx 64rpx;
}

/* 弹窗 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.overlay-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 64rpx;
  text-align: center;
}

.overlay-title {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 32rpx;
}

/* 规则弹窗（羊皮纸风格） */
.rules-box {
  background: #f5e6c8;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  width: 560rpx;
  max-height: 80vh;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.5);
}

.rules-title {
  font-size: 40rpx;
  color: #6b4a1f;
  text-align: center;
  margin-bottom: 28rpx;
  font-weight: bold;
}

.rules-list {
  max-height: 52vh;
  overflow-y: auto;
}

.rules-item {
  font-size: 26rpx;
  color: #5a3e1a;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.rules-close {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6b4a1f;
  background: #e5d0a0;
  border-radius: 28rpx;
  padding: 16rpx 0;
}

/* 行棋日志弹窗 */
.log-box {
  width: 620rpx;
}

.log-list {
  max-height: 52vh;
  background: #fbf3e0;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.log-text {
  font-size: 24rpx;
  color: #5a3e1a;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.log-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.log-btn {
  flex: 1;
  margin-top: 0;
}

.btn {
  background: #555;
  color: #fff;
}

.btn-primary {
  background: #c0392b;
}
