.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  background: #2b2b2b;
}

.title {
  font-size: 40rpx;
  color: #eee;
  margin-bottom: 16rpx;
}

.status {
  height: 48rpx;
  line-height: 48rpx;
  margin-bottom: 20rpx;
}

.status-text {
  color: #ccc;
  font-size: 28rpx;
}

.thinking {
  color: #f0c060;
  font-size: 28rpx;
}

.board {
  position: relative;
  display: grid;
  grid-template-columns: repeat(9, 72rpx);
  grid-template-rows: repeat(9, 72rpx);
  gap: 4rpx;
  padding: 12rpx;
  background: #d9b382;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.cell {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: #c79a66;
  border-radius: 6rpx;
}

.cell-throne {
  background: #8a5a2b;
}

.cell-stronghold {
  background: #b98950;
}

.piece {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  transition: transform 0.15s ease;
}

.piece-attacker {
  background: #222;
  box-shadow: inset 0 -4rpx 6rpx rgba(0, 0, 0, 0.6), 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.piece-defender {
  background: #f5f5f5;
  box-shadow: inset 0 -4rpx 6rpx rgba(0, 0, 0, 0.2), 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

.piece-king {
  background: #f0c060;
  box-shadow: inset 0 -4rpx 6rpx rgba(0, 0, 0, 0.3), 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.piece-selected {
  transform: translate(-50%, -50%) scale(1.15);
}

.controls {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn {
  background: #555;
  color: #fff;
}

.btn-primary {
  background: #c0392b;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.overlay-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 64rpx;
  text-align: center;
}

.overlay-title {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 32rpx;
}
